+    def fit( self, *args, **kwargs ):
+        """
+        Wraps ``tf.keras.Model.fit`` so that when resuming from ``initial_epoch > 0``,
+        Keras's native ``TensorLikeDataAdapter`` (``tf.random.shuffle``) is built for the
+        full ``epochs`` horizon and its dataset iterator advances past the ``initial_epoch``
+        already-completed epochs before training resumes.
+        """
+        initial_epoch = int( kwargs.get('initial_epoch', 0) or 0 )
+        if initial_epoch <= 0:
+            return super().fit( *args, **kwargs )
+        from keras.src.engine import data_adapter
+        orig_get_data_handler = data_adapter.get_data_handler
+        def _resumed_get_data_handler( *dh_args, **dh_kwargs ):
+            init_ep = int( dh_kwargs.get('initial_epoch', 0) or 0 )
+            if init_ep > 0:
+                dh_kwargs_full = dict( dh_kwargs, initial_epoch=0 )
+                dh = orig_get_data_handler( *dh_args, **dh_kwargs_full )
+                dh._initial_epoch = init_ep
+                dh._dataset = dh._dataset.skip( init_ep * dh.inferred_steps )
+                return dh
+            return orig_get_data_handler( *dh_args, **dh_kwargs )
+        data_adapter.get_data_handler = _resumed_get_data_handler
